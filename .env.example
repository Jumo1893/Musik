# Vorlage für eigene Einstellungen: nach .env kopieren und anpassen.
# Ohne .env gelten die Werte, die hier stehen.

# Adresse der App im Browser: http://localhost:8090
WEB_PORT=8090
# 127.0.0.1 = nur von diesem Rechner erreichbar, 0.0.0.0 = auch aus dem Heimnetz.
# Die App hat keine Anmeldung – nur in vertrauten Netzen öffnen.
WEB_BIND=127.0.0.1

# Zugangsdaten der Datenbank. Sie werden beim allerersten Start angelegt; spätere
# Änderungen hier wirken erst, nachdem das Volume neu angelegt wurde.
POSTGRES_DB=musik
POSTGRES_USER=musik
POSTGRES_PASSWORD=musik

# Land des iTunes-Katalogs für die Online-Suche (de, at, ch, us …).
# Bestimmt auch, in welchen Apple-Music-Store die Links führen.
ITUNES_COUNTRY=de

# YouTube-Anbindung (optional): Client-ID und Client-Secret eines OAuth-Clients vom Typ
# „Web application“ aus der Google Cloud Console. Die Anleitung steht im README und in der
# App auf der Seite „YouTube“. Als Rücksprungadresse bei Google eintragen:
#   http://localhost:8090/api/youtube/callback   (bei anderem WEB_PORT entsprechend)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Nur für die Entwicklung (docker-compose.dev.yml): Port der Datenbank auf dem Rechner.
DB_PORT=5433
